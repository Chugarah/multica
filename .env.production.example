# =============================================================================
# Multica production environment template.
# Copy to .env.production and fill in EVERY value. The compose file refuses to
# start if any of the required keys are empty (see the :? guards in
# docker-compose.prod.yml).
#
# .env.production is gitignored and stays on the server only.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Generate a strong password: openssl rand -base64 32
POSTGRES_DB=multica
POSTGRES_USER=multica
POSTGRES_PASSWORD=

# --- Server (backend) --------------------------------------------------------
# REQUIRED: long random secret signing JWTs. Rotate by changing here and
# restarting the backend; existing sessions become invalid.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Public origin of the deployed app (used for redirect URLs, email links, CORS).
FRONTEND_ORIGIN=https://multica.chugarah.com
MULTICA_APP_URL=https://multica.chugarah.com

# CORS / WebSocket origin allow-list (comma-separated). Both names are read by
# different parts of the server; keep them in sync.
ALLOWED_ORIGINS=https://multica.chugarah.com
CORS_ALLOWED_ORIGINS=https://multica.chugarah.com

# Cookie domain — leading dot allows subdomain reuse if you ever add e.g.
# api.multica.chugarah.com. Leave blank to scope to the host only.
COOKIE_DOMAIN=.chugarah.com

# --- Email (Resend) ----------------------------------------------------------
# If RESEND_API_KEY is empty, the server prints OTP codes to stdout; users can
# also use the master code 888888 for testing. Set both for real email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@multica.ai

# --- Google OAuth (optional) -------------------------------------------------
# Leave empty to disable Google sign-in. Redirect URI must match what's
# registered in your Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://multica.chugarah.com/auth/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- File storage (optional) -------------------------------------------------
# Leave S3_BUCKET empty to use local disk storage in the backend_uploads
# Docker volume. Fine for personal use; switch to S3 for multi-host or large
# upload volumes.
S3_BUCKET=
S3_REGION=us-west-2
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# --- Frontend build args -----------------------------------------------------
# Auto-derived from page origin in the browser if blank. Override only if the
# WS endpoint differs from the page host.
NEXT_PUBLIC_WS_URL=

# --- Cloudflare Tunnel -------------------------------------------------------
# REQUIRED: token from Cloudflare Zero Trust dashboard.
# Networks > Tunnels > multica-home > "Install and run a connector" > copy
# the long string after `--token`. NOT the tunnel ID.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Build metadata (optional) -----------------------------------------------
# Surfaced inside the multica CLI binary's --version output. Update before
# tagging a release.
MULTICA_VERSION=prod
MULTICA_COMMIT=
